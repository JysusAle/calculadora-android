<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvTitulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/titulo"
                android:textSize="34sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spCalculo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:entries="@array/opciones_calculo" />

            <ImageView
                android:id="@+id/ivFormula"
                android:layout_width="260dp"
                android:layout_height="150dp"
                android:layout_marginTop="12dp"
                android:contentDescription="@string/desc_formula"
                android:scaleType="fitCenter"
                android:src="@drawable/formula_imc" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilCampo1"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:hint="@string/campo_peso"
                app:helperText="@string/ayuda_peso"
                app:suffixText="@string/unidad_kg">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etCampo1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:importantForAutofill="no"
                    android:inputType="numberSigned|numberDecimal"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilCampo2"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/campo_altura"
                app:helperText="@string/ayuda_altura"
                app:suffixText="@string/unidad_m">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etCampo2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:importantForAutofill="no"
                    android:inputType="numberSigned|numberDecimal"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilCampo3"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:visibility="gone"
                android:hint="@string/campo_tiempo_anios"
                app:helperText="@string/ayuda_tiempo_anios"
                app:suffixText="@string/unidad_anios">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etCampo3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:importantForAutofill="no"
                    android:inputType="numberSigned|numberDecimal"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <Button
                android:id="@+id/btnCalcular"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:backgroundTint="@color/button_state_colors"
                android:paddingStart="48dp"
                android:paddingEnd="48dp"
                android:text="@string/calcular"
                android:textColor="@color/button_text_state_colors"
                android:textSize="22sp" />

            <TextView
                android:id="@+id/tvResultado"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="8dp"
                android:gravity="center"
                android:textSize="22sp"
                tools:text="IMC: 22.50 — Peso normal" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
